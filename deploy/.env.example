# Copy to .env, then set the domain and certificate contact below.

# Public DNS name must point to this server; inbound ports 80 and 443 must be open.
ONECART_DOMAIN=shop.example.com
ACME_EMAIL=admin@example.com

# Optional SMTP configuration. Password reset mail is unavailable until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
