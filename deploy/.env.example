# Copy to .env, then set the domain and certificate contact below.

# Public DNS name must point to this server; inbound ports 80 and 443 must be open.
ONECART_DOMAIN=shop.example.com
ACME_EMAIL=admin@example.com

# Private container network. Choose a non-overlapping subnet if it conflicts with an existing Docker/VPN network.
ONECART_EDGE_SUBNET=172.30.0.0/24
ONECART_CADDY_IP=172.30.0.2
ONECART_API_IP=172.30.0.3

# Optional SMTP configuration. Password reset mail is unavailable until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
