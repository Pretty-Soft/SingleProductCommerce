# Install as /etc/onecart/api.env and replace all example values.
# Restrict the file to the onecart service account and deployment operator.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080
Database__Provider=PostgreSql
ConnectionStrings__Store=Host=127.0.0.1;Port=5432;Database=onecart;Username=onecart;Password=CHANGE_ME
Cors__AllowedOrigins__0=https://shop.example.com
ForwardedHeaders__KnownProxies__0=127.0.0.1
DataProtection__KeyDirectory=/var/lib/onecart/data-protection-keys
ProductMedia__RootPath=/var/lib/onecart/product-images
Setup__BootstrapTokenFile=/etc/onecart/setup-token
Email__PasswordResetUrl=https://shop.example.com/admin/reset-password
# Optional SMTP settings; fill these only when password-reset email is configured.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__From=
